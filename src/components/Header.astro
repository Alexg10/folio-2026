---
import { site } from '../data/site';

interface Props {
  /** Smaller wordmark, no tagline (project pages) */
  compact?: boolean;
  /** Tagline block centered on the page, text stays left-aligned (About) */
  centered?: boolean;
}

const { compact = false, centered = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Work', active: path === '/' || path.startsWith('/projects') },
  { href: '/about', label: 'About', active: path.startsWith('/about') },
];
---

<header class="relative grid gap-3 lg:gap-6">
  <nav
    aria-label="Main"
    class="flex justify-end gap-4 [view-transition-name:nav] lg:absolute lg:top-0 lg:right-0 lg:flex-col lg:items-end lg:gap-0.5"
  >
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={l.active ? 'page' : undefined}
          class="flex items-center gap-1.5 hover:text-muted aria-[current=page]:after:h-2.5 aria-[current=page]:after:w-7 aria-[current=page]:after:bg-current aria-[current=page]:after:content-['']"
        >
          {l.label}
        </a>
      ))
    }
  </nav>
  <a
    href="/"
    aria-label={`${site.name}, home`}
    class:list={[
      'justify-self-start -ml-[0.04em] leading-[0.8] font-black font-stretch-125% tracking-[-0.06em] [view-transition-name:wordmark] lg:pr-28',
      compact ? 'text-[14.5vw] lg:text-[clamp(3rem,5vw,6rem)]' : 'text-[14.5vw] lg:text-[clamp(4rem,8.5vw,11rem)]',
    ]}
  >
    {site.wordmark.map((word) => <span class="block">{word}</span>)}
  </a>
  {
    !compact && (
      <p
        class:list={[
          'mt-2 w-fit max-w-[34ch] text-[clamp(1.125rem,4.5vw,2rem)] leading-[1.1] font-extrabold [view-transition-name:tagline] lg:mt-0',
          centered ? 'mx-auto' : 'lg:ml-[25%]',
        ]}
      >
        {site.tagline}
      </p>
    )
  }
</header>
