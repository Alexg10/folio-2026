---
interface Props {
  text: string;
  /** Delay before the first letter (ms) */
  delay?: number;
  /** Delay between two letters (ms) */
  step?: number;
}

const { text, delay = 0, step = 18 } = Astro.props;

// Words stay unbreakable so wrapping only happens between words
let i = 0;
const words = text.split(' ').map((word) => [...word].map((char) => ({ char, i: i++ })));
---

<span class="sr-only">{text}</span>
<span aria-hidden="true">
  {
    words.map((letters, w) => (
      <>
        {/* clip-path (not overflow) masks the letters without moving the baseline */}
        <span class="inline-block whitespace-nowrap [clip-path:inset(-20%_-5%_0_-5%)]">
          {letters.map(({ char, i }) => (
            <span
              class="inline-block translate-y-[110%] transition-transform duration-200 ease-in group-data-active:translate-y-0 group-data-active:duration-700 group-data-active:ease-[cubic-bezier(0.16,1,0.3,1)] group-data-active:[transition-delay:var(--delay)] motion-reduce:transition-none"
              style={`--delay: ${delay + i * step}ms`}
            >
              {char}
            </span>
          ))}
        </span>
        {w < words.length - 1 && ' '}
      </>
    ))
  }
</span>
